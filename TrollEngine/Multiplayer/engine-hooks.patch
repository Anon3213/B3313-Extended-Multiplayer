@@ -50,6 +50,13 @@
 ; cavin's code with source code aint no fucking way
 .include "Objects/Cavins_B3313_ASM.asm"
 
+.ifdef MULTIPLAYER
+; bhvMario's second CALL_NATIVE, bhv_mario_update, now goes through multiplayer code.
+; Behavior scripts run from rmseg13: the copy at their vanilla ROM offset is never loaded.
+.orga rmseg13+0x2EC0+0x28
+.word mp_mario_update
+.endif
+
 
 .orga 0x130C ;8024630C
 ; gEffectsMemoryPool size
@@ -211,6 +218,45 @@ JAL     spawn_default_star_at_prescaled
 .orga 0x01203FA4 ; spawn when unloaded
 J       spawn_default_star_at_prescaled
 
+.ifdef MULTIPLAYER
+; Every object's update goes through multiplayer code, which mirrors objects another player's
+; game runs instead of running them (Multiplayer/objects.c). These are the two calls to
+; cur_obj_update, in update_objects_starting_at and update_objects_during_time_stop.
+.orga 0x57B78 ; 0x8029CB78
+JAL     mp_cur_obj_update
+.orga 0x57CB8 ; 0x8029CCB8
+JAL     mp_cur_obj_update
+
+; The game reads its controllers through multiplayer code, which shows it none of what they
+; hold while the player types a line of chat (Multiplayer/people.c). This is the call to
+; osContGetReadData in read_controller_inputs, the only one in the ROM.
+.orga 0x366C ; 0x8024866C
+JAL     mp_read_pads
+
+; Mario's model calls the game's own functions for how see-through he is and which body to draw.
+; These are every place its layouts name them, B3313's copies included; they now call through
+; Multiplayer/puppet.c, which fades other players in and out.
+.orga 0x12A7A8
+.word mp_mario_set_alpha
+.orga 0x11A46B8
+.word mp_mario_set_alpha
+.orga 0x11D9A30
+.word mp_mario_set_alpha
+.orga 0x12A694
+.word mp_mario_cap_effect
+.orga 0x12A6C8
+.word mp_mario_cap_effect
+.orga 0x12A6FC
+.word mp_mario_cap_effect
+.orga 0x11A46D4
+.word mp_mario_cap_effect
+.orga 0x11D9A4C
+.word mp_mario_cap_effect
+
+; Last, since it changes .headersize.
+.include "Multiplayer/segment.asm"
+.endif
+
 
 
 .close 
